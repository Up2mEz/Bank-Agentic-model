# Copy to .env and enter your key locally. Never paste the key into chat.
TABPFN_TOKEN=

# Optional lending document/agent providers (server only; never ship in Android).
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_OCR_MODEL=typhoon-ocr

# Private authentication between Case API and Agent service (32+ characters).
# agent_app/run_demo.py creates a local token automatically for local testing.
AGENT_SERVICE_TOKEN=
AGENT_SERVICE_URL=
